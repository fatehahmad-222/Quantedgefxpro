# Public production origin, without a trailing slash.
# Example: https://quantedgefxpro.com
NEXT_PUBLIC_SITE_URL=

# Meta browser Pixel. Leave blank to disable client-side tracking.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API. Leave both blank to keep the endpoint idle (204).
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
